<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:fitsSystemWindows="true"
    android:background="#F8FAFC">

    <TextView
        android:id="@+id/tvTitulo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Calculadora"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="#0F172A"
        android:gravity="center"
        android:layout_marginTop="48dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <EditText
        android:id="@+id/etNumero1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Operando A"
        android:inputType="numberDecimal|numberSigned"
        android:singleLine="true"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitulo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <EditText
        android:id="@+id/etNumero2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Operando B"
        android:inputType="numberDecimal|numberSigned"
        android:singleLine="true"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/etNumero1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/btnSomar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minWidth="0dp"
        android:text="+"
        android:textSize="20sp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintTop_toBottomOf="@id/etNumero2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnSubtrair"/>

    <Button
        android:id="@+id/btnSubtrair"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minWidth="0dp"
        android:text="-"
        android:textSize="20sp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintTop_toTopOf="@id/btnSomar"
        app:layout_constraintStart_toEndOf="@id/btnSomar"
        app:layout_constraintEnd_toStartOf="@id/btnMultiplicar"/>

    <Button
        android:id="@+id/btnMultiplicar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minWidth="0dp"
        android:text="×"
        android:textSize="20sp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintTop_toTopOf="@id/btnSomar"
        app:layout_constraintStart_toEndOf="@id/btnSubtrair"
        app:layout_constraintEnd_toStartOf="@id/btnDividir"/>

    <Button
        android:id="@+id/btnDividir"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minWidth="0dp"
        android:text="÷"
        android:textSize="20sp"
        android:layout_marginStart="4dp"
        app:layout_constraintTop_toTopOf="@id/btnSomar"
        app:layout_constraintStart_toEndOf="@id/btnMultiplicar"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tvResultado"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Resultado:"
        android:textSize="24sp"
        android:textColor="#0F172A"
        android:gravity="center"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toBottomOf="@id/btnSomar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/btnCompartilhar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Compartilhar resultado"
        android:textColor="#FFFFFF"
        android:backgroundTint="#0F766E"
        android:visibility="gone"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toTopOf="@id/btnLogout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/btnLogout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Sair da conta"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
